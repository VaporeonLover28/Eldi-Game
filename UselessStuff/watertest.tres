code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_vtx_4;
uniform vec4 ColorParameter : source_color = vec4(0.082353, 0.094118, 0.141176, 1.000000);
uniform sampler2D tex_frg_4;
uniform sampler2D tex_frg_9;



void vertex() {
// Input:2
	float n_out2p0 = TIME;


// UVFunc:5
	vec2 n_in5p1 = vec2(0.00700, 0.00500);
	vec2 n_out5p0 = vec2(n_out2p0) * n_in5p1 + UV;


// Texture2D:4
	vec4 n_out4p0 = texture(tex_vtx_4, n_out5p0);


// Input:7
	vec3 n_out7p0 = NORMAL;


// Input:6
	vec3 n_out6p0 = VERTEX;


// MultiplyAdd:8
	vec4 n_out8p0 = (n_out4p0 * vec4(n_out7p0, 0.0)) + vec4(n_out6p0, 0.0);


// VectorOp:9
	vec3 n_in9p1 = vec3(1.00000, 4.00000, 1.00000);
	vec3 n_out9p0 = vec3(n_out8p0.xyz) / n_in9p1;


// Output:0
	VERTEX = n_out9p0;


}

void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = ColorParameter;


// Input:5
	float n_out5p0 = TIME;


// UVFunc:6
	vec2 n_in6p1 = vec2(0.00700, 0.00500);
	vec2 n_out6p0 = vec2(n_out5p0) * n_in6p1 + UV;


// Texture2D:4
	vec4 n_out4p0 = texture(tex_frg_4, n_out6p0);


// Input:7
	float n_out7p0 = TIME;


// UVFunc:12
	vec2 n_in12p1 = vec2(-0.00700, -0.00500);
	vec2 n_out12p0 = vec2(n_out7p0) * n_in12p1 + UV;


// Texture2D:9
	vec4 n_out9p0 = texture(tex_frg_9, n_out12p0);


// VectorOp:10
	vec4 n_out10p0 = n_out4p0 * n_out9p0;


// VectorOp:11
	vec4 n_in11p1 = vec4(1.25000, 1.18000, 1.25500, 0.00000);
	vec4 n_out11p0 = pow(n_out10p0, n_in11p1);


// VectorOp:3
	vec4 n_out3p0 = n_out2p0 + n_out11p0;


// FloatConstant:13
	float n_out13p0 = 0.750000;


// FloatConstant:14
	float n_out14p0 = 0.000000;


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out13p0;
	ROUGHNESS = n_out14p0;
	EMISSION = vec3(n_out11p0.xyz);


}
